{
  "name": "flag-management-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "test": "npm run test -w server && npm run test -w shared",
    "test:integration": "npm run test:integration -w server",
    "test:e2e": "npm run test:e2e -w server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web && npm run typecheck -w shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.0.1",
    "eslint-plugin-vitest": "^0.5.4",
    "prettier": "^3.4.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
