generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ApiKeyScope {
  MANAGE
  EVALUATE
  SYNC
  ALL
}

enum ActorType {
  SESSION
  API_KEY
}

enum GlobalRole {
  ADMIN
  DEVELOPER
  PRODUCT_OWNER
}

enum ProjectRole {
  ADMIN
  DEVELOPER
  PRODUCT_OWNER
}

// FR-56: owning project; flag key is unique within the project.
model Flag {
  id          String   @id @db.Char(26)
  projectId   String   @map("project_id") @db.Char(26)
  key         String
  description String   @default("") @db.VarChar(1024)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  definitions FlagDefinition[]

  @@unique([projectId, key], name: "flag_project_key")
  @@map("flags")
}

// FR-7/FR-10: one definition per (flag, env); enabled + variants + ordered rules.
model FlagDefinition {
  id             String   @id @db.Char(26)
  flagId         String   @map("flag_id") @db.Char(26)
  env            String   @db.VarChar(64)
  enabled        Boolean  @default(false)
  variants       Json
  defaultVariant String   @map("default_variant") @db.VarChar(64)
  rules          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  flag Flag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, env], name: "flag_def_flag_env")
  @@map("flag_definitions")
}

model ApiKey {
  id         String      @id @db.Char(26)
  name       String      @db.VarChar(128)
  keyHash    String      @unique @map("key_hash") @db.Char(64)
  keyPrefix  String      @map("key_prefix") @db.VarChar(8)
  scope      ApiKeyScope
  createdAt  DateTime    @default(now()) @map("created_at") @db.DateTime(6)
  lastUsedAt DateTime?   @map("last_used_at") @db.DateTime(6)
  revokedAt  DateTime?   @map("revoked_at") @db.DateTime(6)
  createdBy  String      @map("created_by") @db.VarChar(128)

  @@map("api_keys")
}

model AuditLog {
  id        String    @id @db.Char(26)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  actorType ActorType
  actorName String    @map("actor_name") @db.VarChar(128)
  action    String    @map("action") @db.VarChar(64)
  entity    String    @map("entity") @db.VarChar(32)
  entityId  String    @map("entity_id") @db.VarChar(256)
  env       String?   @map("env") @db.VarChar(64)
  before    Json?
  after     Json?

  @@map("audit_logs")
}

model Project {
  id        String   @id @db.Char(26)
  key       String   @unique @map("key") @db.VarChar(128)
  name      String   @unique @map("name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  environments ProjectEnvironment[]
  memberships  ProjectMembership[]

  @@map("projects")
}

model ProjectEnvironment {
  projectId String   @map("project_id") @db.Char(26)
  env       String   @map("env") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, env])
  @@map("project_environments")
}

model User {
  userName     String     @id @map("user_name") @db.VarChar(128)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  globalRole   GlobalRole
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(6)

  memberships ProjectMembership[]

  @@map("users")
}

model ProjectMembership {
  userName  String      @map("user_name") @db.VarChar(128)
  projectId String      @map("project_id") @db.Char(26)
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(6)

  user    User    @relation(fields: [userName], references: [userName], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userName, projectId])
  @@map("project_memberships")
}
